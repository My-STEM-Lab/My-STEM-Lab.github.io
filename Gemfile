source "https://rubygems.org"

# This mirrors what GitHub Pages runs, so a local preview matches the live site.
# To preview locally:  bundle install  then  bundle exec jekyll serve
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Needed on newer Ruby versions
gem "webrick"
